# External VLLM Configuration
# For containerized deployment, use host.docker.internal to reach VLLM on host machine
# For local development (non-Docker), use localhost
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=not_required_for_local  # Or set if your VLLM requires auth
VLLM_MODEL=your-model-name  # e.g., meta-llama/Llama-3.1-8B-Instruct

# Optional: API keys for weather services
METEO_BLUE_API_KEY=optional
OPEN_METEO_API_KEY=not_required_for_free_tier

# Agent configuration
AGENT_TIMEOUT_SECONDS=60
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
