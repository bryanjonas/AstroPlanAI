# LLM API Configuration (OpenAI-compatible endpoint)
# Set LLM_BASE_URL to your LLM server's base URL
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not_required_for_local  # Or set if your LLM server requires auth
LLM_MODEL=your-model-name  # e.g., meta-llama/Llama-3.1-8B-Instruct

# Legacy aliases (still supported for backward compatibility)
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=not_required_for_local
# VLLM_MODEL=your-model-name

# Optional: API keys for weather services
METEO_BLUE_API_KEY=optional
OPEN_METEO_API_KEY=not_required_for_free_tier

# Agent configuration
AGENT_TIMEOUT_SECONDS=60
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
